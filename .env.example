# =============================================================================
# FORTUNER CRM — configuración (copie este archivo como .env y complete los valores)
# =============================================================================

# --- Servidor web -------------------------------------------------------------
# production = exige claves de acceso (el servidor NO arranca sin ellas) y oculta /api/docs.
# development = permite arrancar sin claves (solo para uso local).
CRM_ENV=production
CRM_HOST=127.0.0.1
CRM_PORT=8900
# Orígenes CORS permitidos, separados por comas y SIN "*". Vacío = solo el mismo origen.
CRM_CORS_ORIGINS=
CRM_LOG_LEVEL=INFO

# --- Seguridad ------------------------------------------------------------------
# Genere cada clave con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Lectura/uso normal del CRM (X-API-Key o Authorization: Bearer)
CRM_API_KEY=
# Administración (cargar datos desde el ERP)
CRM_ADMIN_KEY=
# Peticiones por minuto, por IP, a /api/campanas/ia/* (consumen tokens). 0 = sin límite.
CRM_IA_RATE_LIMIT=30

# --- Contexto comercial --------------------------------------------------------
# Zona donde opera el negocio: la IA la usa para proponer productos por temporada.
CRM_CIUDAD=Manizales
CRM_DEPARTAMENTO=Caldas

# --- Datos ----------------------------------------------------------------------
# CRM_DATA_DIR=D:/fortuner-crm-data     # por defecto ./data
# Meses de historia que se traen del ERP (36 = tres años; el ERP puede tener menos)
CRM_ETL_MESES=36

# --- Fuente: Advantage Database Server 10.10 (ERP FORTUNER, diccionario PUBLIDATA) ---
ADS_DRIVER=Advantage StreamlineSQL ODBC
# Servidor del ERP:  \\SERVIDOR_ERP:2000\C$\ADD_FORTUNER\PUBLIDATA.add
ADS_DATA_DIRECTORY=C:\ADD_FORTUNER\PUBLIDATA.add
ADS_USER=
ADS_PASSWORD=
# 1 = local, 2 = remoto (ADS), 3 = intentar local y luego remoto
ADS_SERVER_TYPES=2
ADS_COMM_TYPE=
ADS_PAGE_SIZE=20000
ADS_FETCH_SIZE=20000

# --- Clientes 360° ----------------------------------------------------------------
# Diccionario PROPIO del CRM (tablas CRM_*). NO es PUBLIDATA: lo crea  crm clientes instalar  en ESTE servidor Advantage.
# Recomendado: subcarpeta CRM de la carpeta del ERP (así entra en los respaldos de esa carpeta). Misma forma que ADS_DATA_DIRECTORY.
#   Ej. local: C:\ADD_FORTUNER\CRM\CRM_FORTUNER.add     Ej. red: \SERVIDOR_ERP:2000\C$\ADD_FORTUNER\CRM\CRM_FORTUNER.add
ADS_CRM_DIRECTORY=
ADS_CRM_USER=AdsSys
# Entre 10 y 20 caracteres, sin comillas (límite de Advantage). scripts/instalar.sh la genera sola.
ADS_CRM_PASSWORD=
# Carpeta de tablas libres de GANAPTOS (GANMASCOTA, GANPROFE, GANAUTOS, GANBARRIO, CIUDAD, DPTOS). Solo lectura.
ADS_CATALOGOS_DIRECTORY=
# Interruptor maestro: false = Clientes 360° en SOLO LECTURA (empezar así en producción). true = se puede editar POSCLI.
CRM_CLIENTES_ESCRITURA=false
# Cada cuántos minutos se relee la lista de clientes del ERP.
CRM_CLIENTES_REFRESCO_MIN=15
# (Opcional) Código de sucursal que se graba en POSCLI.SUCURSAL al crear un cliente desde el CRM.
CRM_CLIENTES_SUCURSAL_ALTA=

# --- IA (cualquier API compatible con OpenAI; por defecto DeepSeek) --------------
DEEPSEEK_API_KEY=
# LLM_API_KEY=              # alternativa genérica (tiene prioridad)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=90
